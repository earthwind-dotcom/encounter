{
  "name": "encounter",
  "version": "0.1.0",
  "private": true,
  "description": "Encounter: an honest, research-grounded path to meeting Jesus and reading the Bible well.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mts",
