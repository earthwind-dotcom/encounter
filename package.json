    "migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate.mts",
    "import:vault": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-vault.mts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
